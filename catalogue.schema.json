{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalogue M'Toolbox",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "type": { "enum": ["windows-app", "web-app", "tools", "script"] },
          "logo": { "type": "string", "description": "Chemin relatif dans le repo, ex. logos/mon-app.png" },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "lead": { "type": "string" },
          "contributors": { "type": "integer", "minimum": 0 },
          "lastActivity": { "type": "string", "format": "date" },
          "source": {
            "type": "object",
            "required": ["kind", "url"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["github", "devops", "script"] },
              "url": { "type": "string" }
            }
          },
          "launch": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["url", "path", "command", "github-release"] },
              "value": { "type": "string", "description": "URL, chemin, commande, ou motif du fichier de release (ex. *Setup.exe)" }
            }
          }
        }
      }
    }
  }
}
