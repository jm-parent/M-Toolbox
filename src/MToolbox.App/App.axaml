<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MToolbox.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MToolbox/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <Color x:Key="WindowBackgroundColor">#151515</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#151515" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CardBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#262626" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38B6FF" />
    <SolidColorBrush x:Key="ChipBrush" Color="#2A2A2A" />
  </Application.Resources>
</Application>
